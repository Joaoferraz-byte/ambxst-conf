+    // Ambxst owns these controls visually; do not duplicate their legacy
+    // status-notifier icons in the bar. Application tray items remain visible.
+    readonly property var hiddenItemTokens: [
+        "nm-applet",
+        "nm-connection-editor",
+        "networkmanager",
+        "blueman",
+        "bluetooth",
+        "easyeffects",
+        "easy-effects",
+        "pasystray",
+        "volumeicon",
+        "wireplumber"
+    ]
+    function isShellManaged(item) {
+        const identity = ((item.id || "") + " " + (item.title || "") + " " + (item.tooltipTitle || "")).toLowerCase();
+        return hiddenItemTokens.some(token => identity.includes(token));
+    }
+    readonly property var visibleItems: SystemTray.items.values.filter(item => !isShellManaged(item))
+    visible: visibleItems.length > 0
 
