index 83464b5..75526b8 100644
--- a/modules/bar/systray/SysTray.qml
+++ b/modules/bar/systray/SysTray.qml
@@ -8,8 +8,37 @@ import qs.modules.components
     variant: "bg"
     id: root
 
-    // Hide when no tray items
-    visible: hasItems
+    // Hide when no tray items. Easy Effects, network and audio controls are
+    // rendered by Ambxst widgets, so only exact SNI identities are filtered.
+    visible: visibleItems.length > 0
+
+    readonly property var hiddenItemTokens: [
+        "nm-applet",
+        "nm-connection-editor",
+        "networkmanager",
+        "blueman-applet",
+        "blueman-manager",
+        "bluetooth",
+        "com.github.wwmm.easyeffects",
+        "easyeffects",
+        "easy-effects",
+        "easy effects",
+        "easy_effects",
+        "pasystray",
+        "volumeicon",
+        "wireplumber"
+    ]
+
+    function isShellManaged(item) {
+        const fields = [item.id, item.title, item.tooltipTitle, item.icon]
+            .filter(value => value !== undefined && value !== null)
+            .map(value => String(value).toLowerCase());
+        return fields.some(field => hiddenItemTokens.some(token =>
+            field === token || field.endsWith("." + token) || field.endsWith("/" + token) ||
+            field.endsWith("-" + token) || field.endsWith("_" + token)));
+    }
+
+    readonly property var visibleItems: SystemTray.items.values.filter(item => !isShellManaged(item))
 
     topLeftRadius: root.vertical ? root.startRadius : root.startRadius
     topRightRadius: root.vertical ? root.startRadius : root.endRadius
@@ -26,7 +55,7 @@ import qs.modules.components
     property bool vertical: bar.orientation === "vertical"
 
     // Hide completely when empty - check both orientations
-    readonly property bool hasItems: rowRepeater.count > 0 || columnRepeater.count > 0
+    readonly property bool hasItems: visibleItems.length > 0
 
     // Ajustes de tamaño dinámicos según orientación
     height: vertical ? implicitHeight : parent.height
@@ -43,7 +72,7 @@ import qs.modules.components
 
         Repeater {
             id: rowRepeater
-            model: SystemTray.items
+            model: root.visibleItems
 
             SysTrayItem {
                 required property SystemTrayItem modelData
@@ -62,7 +91,7 @@ import qs.modules.components
 
