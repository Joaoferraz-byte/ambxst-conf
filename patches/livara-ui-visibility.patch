-    readonly property var visibleItems: allItems.filter(item => !hiddenIds.includes(item.id))
-    readonly property var overflowItems: allItems.filter(item => hiddenIds.includes(item.id))
+    readonly property var hiddenItemTokens: [
+        "nm-applet",
+        "nm-connection-editor",
+        "networkmanager",
+        "blueman-applet",
+        "blueman-manager",
+        "bluetooth",
+        "com.github.wwmm.easyeffects",
+        "com.github.wwmm.easyeffects.desktop",
+        "easyeffects",
+        "easyeffects.desktop",
+        "easy-effects",
+        "easy effects",
+        "easy_effects",
+        "pasystray",
+        "volumeicon",
+        "wireplumber"
+    ]
+    function isShellManaged(item) {
+        const fields = [item.id, item.title, item.tooltipTitle, item.icon]
+            .filter(value => value !== undefined && value !== null)
+            .map(value => String(value).toLowerCase());
+        return fields.some(field => hiddenItemTokens.some(token =>
+            field === token || field.includes(token) || field.endsWith("." + token) ||
+            field.endsWith("/" + token) || field.endsWith("-" + token) ||
+            field.endsWith("_" + token)));
+    }
+    readonly property var visibleItems: allItems.filter(item =>
